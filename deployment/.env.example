# Template only. Copy to ignored deployment/.env after creating Neon DBs/roles.
# Replace every connection placeholder with the matching Neon connection details.
# Keep TLS enabled. Never commit the populated file or paste credentials in chat.
IDENTITY_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_identity;Username=identity_app;Password=REPLACE_WITH_IDENTITY_PASSWORD;SSL Mode=Require;Trust Server Certificate=false
DELIVERY_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_delivery;Username=delivery_app;Password=REPLACE_WITH_DELIVERY_PASSWORD;SSL Mode=Require;Trust Server Certificate=false
MERCHANT_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_merchant;Username=merchant_app;Password=REPLACE_WITH_MERCHANT_PASSWORD;SSL Mode=Require;Trust Server Certificate=false
NOTIFICATIONS_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_notifications;Username=notifications_app;Password=REPLACE_WITH_NOTIFICATIONS_PASSWORD;SSL Mode=Require;Trust Server Certificate=false
BROKER_ADMIN_PASSWORD=REPLACE_LOCAL_ONLY
DELIVERY_BROKER_PASSWORD=REPLACE_LOCAL_ONLY
WORKER_BROKER_PASSWORD=REPLACE_LOCAL_ONLY
OBJECT_ROOT_PASSWORD=REPLACE_LOCAL_ONLY
DELIVERY_OBJECT_ACCESS_KEY=delivery-local
DELIVERY_OBJECT_SECRET_KEY=REPLACE_LOCAL_ONLY
OBJECT_STORE_IMAGE=minio/minio:latest
OBJECT_CLIENT_IMAGE=minio/mc:latest
# Pin tested immutable tags/digests before the implementation baseline is approved.
GATEWAY_IMAGE=swiftdrop/gateway:design-unbuilt
IDENTITY_IMAGE=swiftdrop/identity:design-unbuilt
DELIVERY_IMAGE=swiftdrop/delivery:design-unbuilt
MERCHANT_IMAGE=swiftdrop/merchant:design-unbuilt
WORKER_IMAGE=swiftdrop/notification-worker:design-unbuilt
WEB_IMAGE=swiftdrop/web:design-unbuilt
PUBLIC_API_BASE_URL=http://localhost:5000
WEB_ORIGIN=http://localhost:5173
JWT_ISSUER=https://identity.example.invalid
JWT_AUDIENCE=swiftdrop-api-local
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID
GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_ANDROID_CLIENT_ID
